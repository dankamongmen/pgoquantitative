digraph G {
  node [shape=circle fixedsize=true width=1 height=1 style=filled label="" ]

    nodesep=0.8;
    rankdir="LR"
    base [ label="Base state", color=lightblue ]
  { rank=same;
    gulp [ label="Gulping", color=coral ]
    inact [ label="Inactive", color=grey ]
    gorg [ label="Gorging", color=coral ]
  }
  kod [ label="KOd", color=goldenrod1 ]

  gorg -> gorg [ headlabel="Charged attack/shield", tailport=se, headport=se ]
  gulp -> gulp [ label="Charged attack/shield" ]
  base -> gorg [ label="Surf/Dive, <½ HP" ]
  base -> gulp [ label="Surf/Dive, 󰥮½ HP" ]
  gorg -> inact [ label="Swapout" ]
  gulp -> inact [ label="Swapout" ]
  inact -> base [ label="Swapin" ]
  gorg -> base [ label="Absorb charged attack, OA↓2" ]
  gulp -> base [ label="Absorb charged attack, OD↓" ]
  gorg -> kod [ label="KOd by charged attack, OA↓2" ]
  gulp -> kod [ label="KOd by charged attack, OD↓" ]
  inact -> gorg [ style="invis" ]
  

